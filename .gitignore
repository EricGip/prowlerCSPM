.venv

# Local directory generated by 'terraform init'
.terraform/

# Local state files containing active infrastructure details and secrets
*.tfstate
*.tfstate.*

# Crash logs generated during execution errors
crash.log
crash.*.log

# Variables files containing sensitive data/secrets
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc